[$id]
type=endpoint
auth=$id
aors=$id
allow=!all,ulaw,alaw
callerid="$desc" <$ext>
context=COS_$clst
subscribe_context=$clst
allow_subscribe=yes
device_state_busy_at=0
direct_media=no
dtmf_mode=auto
mailboxes=$ext@$clst
;media_encryption=sdes
;media_encryption_optimistic=yes
named_call_group=$named_call_group
named_pickup_group=$named_pickup_group
rewrite_contact=yes
rtp_symmetric=yes
send_pai=yes
set_var=CHANNEL(parkinglot)=$clstkey
; outbound_proxy line (GenAst Phase F): fleet → sip:{PBX3_SBC_EGRESS_HOST};lr ; singleton → empty
$outbound_proxy
transport=transport-$transport 

[$id]
type=auth
auth_type=userpass
password=$password
username=$id
 
[$id]
type=aor
max_contacts=1
; Softphones (Bria push/app) and NAT can change Contact URI; replace previous single contact
remove_existing=yes
qualify_frequency=30
minimum_expiration=60 
default_expiration=120
maximum_expiration=600
