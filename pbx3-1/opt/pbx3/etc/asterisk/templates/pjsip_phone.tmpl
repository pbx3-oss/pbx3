[$id]
type=endpoint
auth=$id
aors=$id
allow=!all,ulaw,alaw
callerid="$desc" <$ext>
context=COS_$clst
device_state_busy_at=0
direct_media=no
dtmf_mode=auto
mailboxes=$ext@$clst
media_encryption=sdes
media_encryption_optimistic=yes
named_call_group=$clst
named_pickup_group=$clst
rewrite_contact=yes
rtp_symmetric=yes
send_pai=yes
set_var=CHANNEL(parkinglot)=$clstkey
transport=transport-$transport 

[$id]
type=auth
auth_type=userpass
password=$password
username=$id
 
[$id]
type=aor
max_contacts=1
qualify_frequency=30
minimum_expiration=60 
default_expiration=120
maximum_expiration=600
