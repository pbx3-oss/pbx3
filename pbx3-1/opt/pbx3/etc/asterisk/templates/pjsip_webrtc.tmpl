[$id]
type=endpoint
aors=$id
auth=$id
allow=!all,ulaw,alaw,opus,vp8
callerid="$desc" <$ext>
context=$cos_context
subscribe_context=$clst
allow_subscribe=yes
dtls_auto_generate_cert=yes
; Fleet: same signaling path as desk phones — UDP via Magrathea for Dial(…@tenant.fqdn).
; transport-wss alone makes tenant-FQDN DIMs resolve to the instance EIP (hairpin INVITE,
; "No matching endpoint" + "no auth ids available"). Browser still REGISTERs WSS to the SBC;
; Magrathea relays SIP/UDP to this host; outbound_proxy forces dials back through the SBC.
; Singleton/direct WSS may set transport-wss via pjsip_overlay if no fleet edge.
transport=transport-udp
; outbound_proxy line (GenAst Phase F): fleet → sip:{PBX3_SBC_EGRESS_HOST};lr ; singleton → empty
$outbound_proxy
; Must bridge through Asterisk: Snom (RTP) cannot direct-media to browser (DTLS-SRTP/ICE).
; Default direct_media=yes breaks phone→webphone (outbound web often works by chance).
direct_media=no
; Softphones/SIP.js often ignore PRACK; required 100rel can suppress ring progress.
100rel=no
; Session timers on inbound WSS INVITEs have caused mute clients with no SIP reply.
timers=no
; Keep Contact/SDP host public (avoids Contact sip:asterisk@hostname:5060 on WSS INVITE).
from_domain=$fqdn
media_address=$externip
set_var=CHANNEL(parkinglot)=$clstkey
named_call_group=$named_call_group
named_pickup_group=$named_pickup_group
webrtc=yes

[$id]
type=auth
auth_type=userpass
username=$id
password=$password

[$id]
type=aor
max_contacts = 1
; Web browser re-REGISTER often uses a new ephemeral Contact; replace previous single contact
remove_existing=yes
; WSS contacts: OPTIONS qualify often fails and marks Unavail; device state still tracks registration
qualify_frequency=0
minimum_expiration = 60 
default_expiration = 120
maximum_expiration = 600
