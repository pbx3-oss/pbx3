# pbx3 fail2ban jail — Ubuntu 24.04 LTS
# Install: ln -sf /opt/pbx3/etc/fail2ban/jail.local /etc/fail2ban/jail.local
#
# Mission: PBX (Asterisk + API on 44300). Protects: SSH (admin), Asterisk (SIP/registration),
# repeat offenders across jails, and optionally Apache (API probes).

[DEFAULT]
banaction = shorewall

# SSH — admin access; high-value target for brute-force
[sshd]
enabled   = true
filter    = sshd
logpath   = %(auth_log)s
maxretry  = 3
findtime  = 600
bantime   = 86400

# Asterisk: use log file explicitly (Ubuntu 24.04 fail2ban may default to journal;
# logpath forces file-based matching with the system asterisk filter).
[asterisk]
enabled   = true
filter    = asterisk
logpath   = /var/log/asterisk/messages
maxretry  = 5
findtime  = 600
bantime   = 600

# Recidive — ban IPs that get banned in multiple jails (e.g. SSH + Asterisk)
[recidive]
enabled   = true
filter    = recidive
logpath   = /var/log/fail2ban.log
bantime   = 604800
findtime  = 86400
maxretry  = 3

# Apache (API on 44300) — block bad User-Agents / scanners hitting the API
[apache-badbots]
enabled   = true
filter    = apache-badbots
logpath   = /var/log/apache2/ssl_access.log
maxretry  = 1
findtime  = 86400
bantime   = 86400
