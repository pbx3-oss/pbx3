    <phone>
        <MenuPassword>$padminpass</MenuPassword>
        <date>
            <EnableSNTP>1</EnableSNTP>
            <SNTPServer>pool.ntp.org</SNTPServer>
            <SecondSNTPServer>$localip</SecondSNTPServer>
            <TimeZone>0</TimeZone>
            <TimeZoneName>United Kingdom(London)</TimeZoneName>
            <SNTPTimeout>60</SNTPTimeout>
        </date>
    </phone>
    <ap>
        <DownloadCommonConf>0</DownloadCommonConf>
        <SaveProvisionInfo>0</SaveProvisionInfo>
        <CheckFailTimes>3</CheckFailTimes>
        <FlashServerIP>$provurl</FlashServerIP>
        <FlashFileName></FlashFileName>
        <FlashProtocol>5</FlashProtocol>
        <FlashMode>1</FlashMode>
        <FlashInterval>1</FlashInterval>
    </ap>
