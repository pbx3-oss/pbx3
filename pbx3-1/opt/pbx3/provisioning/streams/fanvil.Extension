<?xml version="1.0" encoding="UTF-8"?>
<sysConf>
    <Version>2.0000000000</Version>
#INCLUDE fanvil.Common
    <sip>
        <!-- Global local SIP listen (SIP Global / Local SIP Port). Per-line SignalPort alone still leaves :5060 open. -->
        <SIPPort>5160</SIPPort>
        <STUNServer></STUNServer>
        <STUNPort>3478</STUNPort>
        <STUNRefreshTime>50</STUNRefreshTime>
        <line index="1">
            <PhoneNumber>$sipuser</PhoneNumber>
            <DisplayName>$ext</DisplayName>
            <SipName></SipName>
            <RegisterAddr>$sipdomain</RegisterAddr>
            <RegisterPort>$bindport</RegisterPort>
            <RegisterUser>$sipuser</RegisterUser>
            <RegisterPswd>$password</RegisterPswd>
            <RegisterTTL>3600</RegisterTTL>
            <EnableReg>1</EnableReg>
            <ProxyAddr>$outbound</ProxyAddr>
            <ProxyPort>$bindport</ProxyPort>
            <ProxyUser></ProxyUser>
            <ProxyPswd></ProxyPswd>
            <Transport>0</Transport>
            <MediaCrypto>0</MediaCrypto>
            <EnableRport>1</EnableRport>
            <NATType>0</NATType>
            <NATUDPUpdate>2</NATUDPUpdate>
            <UDPUpdateTTL>30</UDPUpdateTTL>
            <DTMFMode>3</DTMFMode>
            <StrictProxy>1</StrictProxy>
            <!-- Ban Anonymous Call (CLI). No Yealink/GS/Poly-style proxy-only INVITE filter on X3U. -->
            <BanAnonymous>1</BanAnonymous>
            <!-- Local SIP listen port off 5060 — ghost-call obscurity (scanners hit :5060). Server/proxy ports stay $bindport. -->
            <SignalPort>5160</SignalPort>
        </line>
    </sip>
</sysConf>
