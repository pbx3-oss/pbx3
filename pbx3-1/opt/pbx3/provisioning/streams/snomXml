<?xml version="1.0" encoding="utf-8"?>
<!-- snomXml — OEM XML twin of legacy vendor alias snom (#23c).
     Same as Extension plus idle text. Prefer snomXml.Extension for new desks.
     Nested: snomXml.udp + snomXml.ipv4 inside phone-settings — single INCLUDE only. -->
<settings>
<phone-settings e="2">
#INCLUDE snomXml.Common
<user_name idx="1" perm="$">$sipuser</user_name>
<user_realname idx="1" perm="$">$ext</user_realname>
<user_pass idx="1" perm="$">$password</user_pass>
<user_host idx="1" perm="$">$sipdomain</user_host>
<user_idle_text idx="1" perm="$">$ext($desc)</user_idle_text>
#INCLUDE snomXml.udp
#INCLUDE snomXml.ipv4
</phone-settings>
</settings>
