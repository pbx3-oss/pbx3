<?xml version="1.0" encoding="utf-8"?>
<!-- snomXml.Extension — OEM XML twin of snom.Extension (#23c).
     Soft-fill / new Snom desks: #INCLUDE snomXml.Extension
     Transport default = snomXml.udp (inside phone-settings). For tcp/tls,
     copy this stream to Customer and change the transport INCLUDE. -->
<settings>
<phone-settings e="2">
#INCLUDE snomXml.Common
<user_name idx="1" perm="$">$sipuser</user_name>
<user_realname idx="1" perm="$">$ext</user_realname>
<user_pass idx="1" perm="$">$password</user_pass>
<user_host idx="1" perm="$">$sipdomain</user_host>
#INCLUDE snomXml.udp
</phone-settings>
</settings>
