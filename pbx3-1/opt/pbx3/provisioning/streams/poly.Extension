<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- PBX3 poly.Extension — single-file UCS body for {mac}.cfg / {mac}-reg.cfg.
     Lab entry: poly.Extension (+ optional poly.udp). Multi-file master/site
     fetch (000000000000.cfg) not required for this mule path. -->
<polycomConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="polycomConfig.xsd">
#INCLUDE poly.Common
  <reg
    reg.1.displayName="$desc"
    reg.1.address="$sipuser"
    reg.1.label="$ext"
    reg.1.auth.userId="$sipuser"
    reg.1.server.1.address="$sipdomain"
    reg.1.server.1.port="$bindport"
    reg.1.server.1.transport="UDPOnly"
    reg.1.outboundProxy.address="$outbound"
    reg.1.outboundProxy.port="$bindport"
    reg.1.outboundProxy.transport="UDPOnly"
    reg.1.nat.traversal.mode="Auto"
  />
  <reg reg.1.auth.password="$password"/>
</polycomConfig>
