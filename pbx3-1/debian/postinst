#!/bin/bash
set -e
# Package install/upgrade only. Full first-time setup: /opt/pbx3/scripts/installer.sh after install.

SYSPATH=/opt/pbx3

date --iso-8601=minutes > "$SYSPATH/.install-date"

# .deb copy may not preserve git execute bits on helper scripts.
if [ -d "$SYSPATH/scripts" ]; then
	chmod 755 "$SYSPATH/scripts"/*.sh 2>/dev/null || true
fi

# idpwgen is built on the target host (never ship/copy a Mac binary). Required by pbx3api tenant/extension create.
if [ -f "$SYSPATH/golang/idpwgen.go" ] && command -v go >/dev/null 2>&1; then
	rm -f "$SYSPATH/golang/idpwgen"
	if (cd "$SYSPATH/golang" && go build -o idpwgen idpwgen.go); then
		chmod 755 "$SYSPATH/golang/idpwgen" 2>/dev/null || true
	fi
fi

# Ensure runit services exist after upgrade (prerm no longer removes /etc/service on upgrade).
if [ -d "$SYSPATH/service/sys-ua-helper" ]; then
	chmod +x "$SYSPATH/service/sys-ua-helper/run" 2>/dev/null || true
	[ ! -L /etc/service/sys-ua-helper ] && ln -sf "$SYSPATH/service/sys-ua-helper" /etc/service/sys-ua-helper
	sv u sys-ua-helper 2>/dev/null || true
fi
if [ -d "$SYSPATH/service/sys-ua-siplog" ]; then
	chmod +x "$SYSPATH/service/sys-ua-siplog/run" 2>/dev/null || true
	[ ! -L /etc/service/sys-ua-siplog ] && ln -sf "$SYSPATH/service/sys-ua-siplog" /etc/service/sys-ua-siplog
	# Fleet: siplog stays down (service/sys-ua-siplog/down). Solo: sv u sys-ua-siplog
	# Do not sv u here — phones go via SBC in fleet; dumpcap on :5060 is wasteful.
	if [ -f "$SYSPATH/service/sys-ua-siplog/down" ]; then
		sv d sys-ua-siplog 2>/dev/null || true
	fi
fi

NORM=/opt/pbx3/scripts/normalize-globals-identity.sh
if [ -x "$NORM" ] && [ -f /opt/pbx3/db/sqlite.db ]; then
	"$NORM" || true
fi

# Symlink /etc/asterisk → ASTLOCALCONF (static + GenAst stub/ready files). Shipped stubs
# ensure pjsip_ready_*.conf exist before runLinker; genAst below overwrites content in place.
if [ -x "$SYSPATH/scripts/link-asterisk-configs.sh" ]; then
	"$SYSPATH/scripts/link-asterisk-configs.sh" || true
fi

# Phase R1.5: ensure the recordings catalog table exists on an already-provisioned
# instance DB (CREATE TABLE IF NOT EXISTS — safe to re-run; new installs get it
# from sqlite_create_tenant.sql via the installer).
REC_SQL="$SYSPATH/db/db_sql/sqlite_add_recordings_table.sql"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$REC_SQL" ] && command -v sqlite3 >/dev/null 2>&1; then
	sqlite3 /opt/pbx3/db/sqlite.db < "$REC_SQL" >/dev/null 2>&1 || true
fi

# Tenant short dial: dialalias (A′ target_fqdn). CREATE IF NOT EXISTS only —
# does not rebuild a pre-A′ table missing target_fqdn (run target_fqdn SQL once
# by hand if needed). New installs get the table from sqlite_create_tenant.sql.
DIAL_SQL="$SYSPATH/db/db_sql/sqlite_add_dialalias_table.sql"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$DIAL_SQL" ] && command -v sqlite3 >/dev/null 2>&1; then
	sqlite3 /opt/pbx3/db/sqlite.db < "$DIAL_SQL" >/dev/null 2>&1 || true
	# Help seeds (INSERT OR IGNORE) for Dial prefixes panel
	sqlite3 /opt/pbx3/db/sqlite.db <<'EOF' >/dev/null 2>&1 || true
INSERT OR IGNORE INTO tt_help_core(pkey,displayname,htext) values ('dialalias','Dial prefix','2–4 digit prefix local to this tenant. Dial prefix then the remote extension (digits only). Example: prefix 81 + extension 1000 → dial 811000. Feature codes (*…) stay local — not after a prefix.');
INSERT OR IGNORE INTO tt_help_core(pkey,displayname,htext) values ('dialalias_target','Target tenant','Pick another tenant from the known list (this node plus fleet catalog when available). Stored as that tenant’s full FQDN — not the instance hostname. Prefix is only for the calling tenant; reverse needs its own prefix on the other side.');
EOF
fi

# GenAst hermit overlays: idempotent ALTER for upgrade paths (create SQL already
# has columns on fresh installer runs).
OVERLAY_APPLY="$SYSPATH/scripts/apply-sqlite-add-overlay-columns.sh"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$OVERLAY_APPLY" ]; then
	sh "$OVERLAY_APPLY" /opt/pbx3/db/sqlite.db >/dev/null 2>&1 || true
fi

# Extension named call + pickup groups (split fields; migrates legacy named_groups).
NAMED_GROUPS_APPLY="$SYSPATH/scripts/apply-sqlite-add-named-groups.sh"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$NAMED_GROUPS_APPLY" ]; then
	sh "$NAMED_GROUPS_APPLY" /opt/pbx3/db/sqlite.db >/dev/null 2>&1 || true
fi

# Time-based routing (day-parts) slice A: schema + dual-read profile convert.
TIMEBASE_APPLY="$SYSPATH/scripts/apply-sqlite-add-time-based-routing.sh"
TIMEBASE_CONVERT="$SYSPATH/scripts/convert-route-profiles.sh"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$TIMEBASE_APPLY" ]; then
	sh "$TIMEBASE_APPLY" /opt/pbx3/db/sqlite.db >/dev/null 2>&1 || true
	if [ -f "$TIMEBASE_CONVERT" ]; then
		sh "$TIMEBASE_CONVERT" /opt/pbx3/db/sqlite.db >/dev/null 2>&1 || true
	fi
fi

# Default outbound dialplan (globals string → copy to tenant OutRoute on create).
OUTDIAL_APPLY="$SYSPATH/scripts/apply-sqlite-add-default-outbound-dialplan.sh"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$OUTDIAL_APPLY" ]; then
	sh "$OUTDIAL_APPLY" /opt/pbx3/db/sqlite.db >/dev/null 2>&1 || true
fi

# Site Groups (dial cohort C2): managed dialalias projections (source + cohort_id).
# CREATE TABLE IF NOT EXISTS above does not ALTER existing dialalias tables.
DIAL_COHORT_APPLY="$SYSPATH/scripts/apply-sqlite-add-dialalias-cohort.sh"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$DIAL_COHORT_APPLY" ]; then
	sh "$DIAL_COHORT_APPLY" /opt/pbx3/db/sqlite.db >/dev/null 2>&1 || true
fi

# S7 tenant recordings S3 opt-in (cluster.rec_s3 default NO).
REC_S3_APPLY="$SYSPATH/scripts/apply-sqlite-add-rec-s3.sh"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$REC_S3_APPLY" ]; then
	sh "$REC_S3_APPLY" /opt/pbx3/db/sqlite.db >/dev/null 2>&1 || true
fi
if [ -f /opt/pbx3/db/sqlite.db ] && command -v sqlite3 >/dev/null 2>&1; then
	sqlite3 /opt/pbx3/db/sqlite.db <<'EOF' >/dev/null 2>&1 || true
INSERT OR IGNORE INTO tt_help_core(pkey,displayname,htext) values ('recs3','S3 offload','Opt this tenant into fleet S3 disaster recovery for call recordings (default No). Requires the home to have recordings S3 upload plumbing enabled at install. Local archive and max age/size always apply; Yes only adds upload of archived files to the fleet recordings bucket.');
EOF
fi

CLID_BLOCK_SQL="$SYSPATH/db/db_sql/sqlite_add_clid_block.sql"
if [ -f /opt/pbx3/db/sqlite.db ] && [ -f "$CLID_BLOCK_SQL" ] && command -v sqlite3 >/dev/null 2>&1; then
	sqlite3 /opt/pbx3/db/sqlite.db < "$CLID_BLOCK_SQL" >/dev/null 2>&1 || true
	sqlite3 /opt/pbx3/db/sqlite.db <<'EOF' >/dev/null 2>&1 || true
INSERT OR IGNORE INTO tt_help_core(pkey,displayname,htext) values ('clidblock','Blocked caller ID','Digits-only calling line ID to reject on inbound calls for this tenant. Use the same digit form you see in CDR (e.g. 441924918076 or 01924918076). No Commit required — active rows apply on the next inbound call.');
EOF
fi

# After apt upgrade + runLinker, regenerate PJSIP/dialplan from sqlite (HoR) into
# ASTLOCALCONF so symlinked /etc/asterisk is not left pointing at empty/stale ready files.
# Then rewrite external_* to this node's public IP/EIP and restart Asterisk.
if [ -f /opt/pbx3/db/sqlite.db ] && [ -x "$SYSPATH/scripts/genAst.sh" ]; then
	"$SYSPATH/scripts/genAst.sh" >/dev/null 2>&1 || true
	if [ -x "$SYSPATH/scripts/link-asterisk-configs.sh" ]; then
		"$SYSPATH/scripts/link-asterisk-configs.sh" || true
	fi
	if [ -x "$SYSPATH/scripts/refresh-pjsip-externip.sh" ]; then
		"$SYSPATH/scripts/refresh-pjsip-externip.sh" >/dev/null 2>&1 || true
	fi
fi

if [ ! -f /opt/pbx3/db/sqlite.db ]; then
	cat <<'EOF'

pbx3 package installed.

Next step (run once on this server):
  sudo /opt/pbx3/scripts/installer.sh

Once /opt/pbx3/db/sqlite.db exists, re-running installer.sh skips reloader (no full DB rebuild).
To fix legacy empty UID/KSUID in globals without re-running the installer:
  sudo /opt/pbx3/scripts/normalize-globals-identity.sh

EOF
fi
