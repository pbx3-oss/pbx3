        if ($room['type'] == "hosted" ) {			
            $profile = 'pbx3_hosted_user';
        }	
        $this->OUT .= "\tsame => n,ConfBridge(\${EXTEN},,$profile)\n";
        $this->OUT .= "\tsame => n,Hangup()\n";
        }	
    }
