			return $errorMsg;
		}

        foreach ($meetme as $room) {
        $this->OUT .= "\texten => " . $room['pkey'] . ",1,NoOp(conference " . $room['pkey'] . ")\n";
        $this->OUT .= "\tsame => n,Answer(500)\n";
        if ($room['pin'] and $room['pin'] != "None") {
            $this->OUT .= "\tsame => n,Authenticate(" . $room['pin'] . ")\n";
