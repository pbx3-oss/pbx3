PBX3_ORG_BUCKET=
# Dedicated recordings bucket (S7) — never the org/catalog bucket. e.g. 08jzwn-pbx3-recordings
PBX3_RECORDINGS_BUCKET=
GATEKEEPER_API_TOKEN=change-me
AWS_DEFAULT_REGION=us-east-1
# Token used when gatekeeper calls node /api/fleet/* and SBC /api/fleet/*
PBX3_FLEET_SERVICE_TOKEN=change-me-fleet-token
# e.g. https://sbc.pbx3.com/api  (Laravel api prefix)
PBX3_SBC_ADMIN_API_URL=
# Set false if lab nodes use self-signed certs
PBX3_FLEET_HTTP_VERIFY=true
# Optional — if set, awaiting_certs calls dest certificates/sync
# PBX3_LE_EMAIL=
# SQLite path for fleet operator users + session tokens (default: ./data/auth.sqlite)
# GATEKEEPER_AUTH_DB=/var/lib/pbx3-gatekeeper/auth.sqlite

# Ops failure notify (SMTP — portable; Mailer adapter allows other providers later)
# GATEKEEPER_SMTP_HOST=smtp.example.com
# GATEKEEPER_SMTP_PORT=587
# GATEKEEPER_SMTP_USER=
# GATEKEEPER_SMTP_PASS=
# GATEKEEPER_SMTP_FROM=fleet-notify@pbx3.com
# GATEKEEPER_SMTP_TLS=true
# Optional extra mailbox always notified (in addition to users with notify_failures)
# GATEKEEPER_OPS_NOTIFY_EMAIL=ops@example.com
# Optional link in notify mail bodies
# GATEKEEPER_FLEET_UI_URL=https://pages.example/pbx3spa

# SBC edge HA probe / auto-promote (FO lab)
# GATEKEEPER_EDGE_AUTO_PROMOTE=false
# GATEKEEPER_EDGE_PROMOTE_COOLDOWN_MIN=30
# GATEKEEPER_EDGE_SSH_KEY=/etc/pbx3-gatekeeper/edge-ssh.pem
# Key must be readable by php-fpm user (www-data), mode 600. Used to fence old active (stop opensips).
# Phase D after promote: issue LE on new VIP holder (default on when email set)
# GATEKEEPER_EDGE_LE_AFTER_PROMOTE=true
# GATEKEEPER_EDGE_LE_EMAIL=admin@example.com
# Managed Promote now: SIP-OPTIONS standby public IP; 409 + confirm_standby_sip_warning if unseen
