{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRecordingsPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::RECORDINGS_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["tenants/*/recordings/*"]
        }
      }
    },
    {
      "Sid": "RecordingsObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::RECORDINGS_BUCKET/tenants/*/recordings/*"
    }
  ]
}
