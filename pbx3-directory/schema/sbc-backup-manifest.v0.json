{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aelintra.com/pbx3/directory/sbc-backup-manifest.v0.json",
  "title": "PBX3 SBC backup manifest (v0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "scope", "sbc_id", "artifacts"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "const": "sbc" },
    "trigger": {
      "type": "string",
      "enum": ["manual", "scheduled", "pre-upgrade"],
      "description": "How this backup was started"
    },
    "sbc_id": {
      "type": "string",
      "description": "PBX3_SBC_ID — S3 key stem under sbc/{sbc_id}/"
    },
    "node_fqdn": { "type": "string", "format": "hostname" },
    "pbx3sbc_version": {
      "type": "string",
      "description": "Optional git describe / package version at backup time"
    },
    "contents_summary": {
      "type": "object",
      "description": "Optional counts without opening backup.zip",
      "additionalProperties": true
    },
    "restore_tested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last ops restore drill on this package"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
