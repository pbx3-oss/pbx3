{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aelintra.com/pbx3/directory/backup-manifest.v0.json",
  "title": "PBX3 backup manifest (v0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "scope", "instance_id", "artifacts"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "enum": ["instance", "tenant"] },
    "trigger": {
      "type": "string",
      "enum": ["manual", "scheduled", "pre-upgrade"],
      "description": "How this backup was started"
    },
    "instance_id": { "type": "string", "description": "globals.id (KSUID)" },
    "tenant_shortuid": {
      "type": ["string", "null"],
      "description": "Set when scope is tenant"
    },
    "node_fqdn": { "type": "string", "format": "hostname" },
    "pbx3_version": {
      "type": "string",
      "description": "e.g. pbx3 0.0.3-10 at backup time"
    },
    "contents_summary": {
      "type": "object",
      "description": "Optional counts without opening backup.zip",
      "additionalProperties": true
    },
    "restore_tested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last ops restore drill on this package"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
