# Copy to lab.env (gitignored) and edit. Used by run-in-open-ext.sh.
#
# Target: Magrathea VIP / SBC (fleet inbound path).
# Mac-only: your public IP must be (1) allowed on the VIP SG UDP/TCP 5060
# and (2) present in OpenSIPS dr_gateways so is_from_gw matches (FROM_CARRIER).

SBC_HOST=3.93.26.82
SBC_PORT=5060

# R-URI user = inbound DID prefix (lab Magrathea → golden 1000 / dhbm8x)
DID=01924918076

# Local SIPp bind — Mac: ipconfig getifaddr en0 (required if SIPp cannot auto-detect)
LOCAL_IP=
LOCAL_PORT=5061

# One call, then exit. Raise for soak later.
CALLS=1
RATE=1

# Max ms to wait for 200 OK (operator must answer / auto-answer dest)
RECV_TIMEOUT=60000

# --- SIPp catcher (lab tenant on golden; REGISTER + UAS) ---
# Live: tenant pkey=sipp, FQDN={shortuid}.pbx3.com, Twilio DID openroute → 2000
DID_CATCHER=+15139279738
CATCHER_DOMAIN=CHANGE_ME.pbx3.com
CATCHER_USER=CHANGE_ME_SHORTUID
CATCHER_PASS=CHANGE_ME
CATCHER_USER_B=CHANGE_ME_SHORTUID_B
CATCHER_PASS_B=CHANGE_ME
CATCHER_PORT=5070
CATCHER_PORT_B=5071
CATCHER_EXT_A=2000
CATCHER_EXT_B=2001
CATCHER_QUEUE=2060

# Second-tenant peer catcher (affcot) — usrloc contention for in-multi-tenant-a-b
# Live lab: ext 1199 on 9wvvnb.pbx3.com. Optional here — run-pack can load
# PEER_* from golden /tmp/sipp-peer-catcher.env when unset.
# CATCHER_PEER_DOMAIN=9wvvnb.pbx3.com
# CATCHER_PEER_USER=
# CATCHER_PEER_PASS=
CATCHER_PORT_PEER=5072

# SSH to golden for lab-state.sh / run-pack.sh (quote the full ssh command)
# GOLDEN_SSH='ssh -i /path/to/pbx3test.pem -o BatchMode=yes ubuntu@08jzwn.pbx3.com'
GOLDEN_SSH=
