# Copy to lab.env (gitignored) and edit. Used by run-in-open-ext.sh.
#
# Target: Magrathea VIP / SBC (fleet inbound path).
# Mac-only: your public IP must be (1) allowed on the VIP SG UDP/TCP 5060
# and (2) present in OpenSIPS dr_gateways so is_from_gw matches (FROM_CARRIER).

SBC_HOST=3.93.26.82
SBC_PORT=5060

# R-URI user = inbound DID prefix (lab Magrathea → golden 1000 / dhbm8x)
DID=01924918076

# Local SIPp bind — Mac: ipconfig getifaddr en0 (required if SIPp cannot auto-detect)
LOCAL_IP=
LOCAL_PORT=5061

# One call, then exit. Raise for soak later.
CALLS=1
RATE=1

# Max ms to wait for 200 OK (operator must answer / auto-answer ext 1000)
RECV_TIMEOUT=60000
