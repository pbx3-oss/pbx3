<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  catcher-answer-486 — UAS returns SIP 486 Busy Here (reject / busy).

  Keys: user
  After 486 + ACK, Asterisk Dial() ends with DIALSTATUS=BUSY → PostDial.
-->
<scenario name="catcher-answer-486">

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="300"/>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <recv request="ACK" optional="true" crlf="true"/>

</scenario>
