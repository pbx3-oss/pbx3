<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  catcher-answer-302 — UAS that returns SIP 302 (phone divert), not 200.

  Keys:
    user       — this catcher’s shortuid (for logging; Contact is redir)
    redir_ext  — local extension to divert to (e.g. 2001)
    domain     — tenant FQDN (Contact host; Asterisk redirect_method=user
                 uses the Contact *user* only)

  After 302 + ACK, Asterisk Dial() re-invites the Contact user in the
  phone’s COS context (local divert). Separate from AstDB CFIM.
-->
<scenario name="catcher-answer-302">

  <recv request="INVITE" crlf="true"/>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 302 Moved Temporarily
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[redir_ext]@[domain]>
      Content-Length: 0
    ]]>
  </send>

  <recv request="ACK" optional="true" crlf="true"/>

</scenario>
